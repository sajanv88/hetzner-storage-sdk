# Hetzner Storage SDK - Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials

# ============================================================================
# Storage Box Configuration
# ============================================================================
# Required for Storage Box authentication
HETZNER_STORAGE_BOX_USERNAME=u123456
HETZNER_STORAGE_BOX_PASSWORD=your-password

# Optional: Protocol to use (webdav ), defaults to webdav
HETZNER_STORAGE_BOX_PROTOCOL=webdav

# Optional: Storage Box ID (required for Robot API operations)
HETZNER_STORAGE_BOX_ID=12345

# Optional: Robot API credentials (required for management operations like snapshots)
HETZNER_ROBOT_USERNAME=robot-username
HETZNER_ROBOT_PASSWORD=robot-password

# ============================================================================
# Storage Share Configuration (Nextcloud)
# ============================================================================
# Required for Storage Share authentication
HETZNER_STORAGE_SHARE_USERNAME=your-username
HETZNER_STORAGE_SHARE_PASSWORD=your-password

# Required: Your Storage Share instance ID
HETZNER_STORAGE_SHARE_INSTANCE=u123456

# ============================================================================
# Object Storage Configuration (S3-compatible)
# ============================================================================
# Required: S3 credentials
HETZNER_OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key-id
HETZNER_OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key

# Required: Region (fsn1, nbg1, or hel1)
HETZNER_OBJECT_STORAGE_REGION=fsn1

# Required: Default bucket name
HETZNER_OBJECT_STORAGE_BUCKET=my-bucket
