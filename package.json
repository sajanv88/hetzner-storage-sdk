{
  "name": "hetzner-storage-sdk",
  "version": "1.0.1",
  "description": "TypeScript SDK for Hetzner Storage Box, Storage Share, and Object Storage",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "example": "ts-node examples/usage-examples.ts",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write ."
  },
  "keywords": [
    "hetzner",
    "storage",
    "webdav",
    "nextcloud",
    "s3",
    "object-storage",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sajanv88/hetzner-storage-sdk"
  },
  "author": "Sajankumar Vijayan <work@sajankumarv.com>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "axios": "^1.6.0",
    "dotenv": "^17.2.4",
    "ssh2-sftp-client": "^10.0.3",
    "webdav": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
